{
  "name": "myhotlunchbox-mcp",
  "version": "1.0.0",
  "mcpName": "io.github.chrischall/myhotlunchbox-mcp",
  "description": "My Hot Lunchbox MCP server for Claude — developed and maintained by AI (Claude Code)",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/myhotlunchbox-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "myhotlunchbox",
    "school-lunch",
    "lunch-ordering",
    "parent",
    "k12",
    "meal-plan"
  ],
  "type": "module",
  "bin": {
    "myhotlunchbox-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills/",
    ".mcp.json",
    "server.json",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --alias:zod/v4=./node_modules/zod/v4/index.cjs --platform=node --format=esm --external:dotenv --outfile=dist/bundle.js",
    "dev": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "verify:reads": "node scripts/verify-reads.mjs",
    "capture:writes": "node scripts/capture-writes.mjs"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^0.28.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
