# My Hot Lunchbox parent account — the same email/password you use at
# https://ordernow.myhotlunchbox.com
#
# The server signs in with an OAuth2 password grant and renews with the refresh
# token it receives; nothing is stored on disk. Never commit this file.
MYHOTLUNCHBOX_USERNAME=you@example.com
MYHOTLUNCHBOX_PASSWORD=

# Optional — override the app origin (defaults to the value below).
# MYHOTLUNCHBOX_BASE_URL=https://ordernow.myhotlunchbox.com

# Optional — where the print tools write their PDFs. Defaults to the working
# directory. Existing files are never overwritten.
# MYHOTLUNCHBOX_OUTPUT_DIR=./reports
